# ─── OpenAI ────────────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ─── Pinecone ──────────────────────────────────────────────────────────────────
# Get from: https://app.pinecone.io → API Keys
# Create a FREE index named "neuralnote" with 1536 dimensions, cosine metric
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=neuralnote

# ─── Clerk Auth ────────────────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → your app → API Keys
# (Create a new app, choose "Email + Google" sign-in)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get from: https://supabase.com → your project → Settings → API
# Run the SQL in SETUP.md first to create the notes table
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
